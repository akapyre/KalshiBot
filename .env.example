# Kalshi -- generate at https://kalshi.com/account/profile ("Create New API Key").
# The private key file is only shown once; save it immediately.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Odds/game-state provider (default adapter: TheRundown via RapidAPI).
# Swap for SportsDataIO/OddsJam/etc. by writing a new class in
# kalshibot/odds_providers/ and pointing main.py at it.
THERUNDOWN_API_KEY=

# Kill switch -- must be the literal string "true" for --live orders to
# actually submit, on top of not passing --dry-run. Leave unset/false to
# stay in dry-run no matter what.
TRADING_ENABLED=false
