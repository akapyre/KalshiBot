# Kalshi -- generate at https://kalshi.com/account/profile ("Create New API Key").
# The private key file is only shown once; save it immediately.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# Which Kalshi API address to use -- run `python -m kalshibot.diagnose kalshi`
# to find the one that accepts your key.
KALSHI_BASE_URL=

# Odds/game-state provider (default adapter: sportsgameodds.com).
# Swap for another vendor by writing a new class in
# kalshibot/odds_providers/ and pointing main.py at it.
SPORTSGAMEODDS_API_KEY=

# Kill switch -- must be the literal string "true" for --live orders to
# actually submit, on top of not passing --dry-run. Leave unset/false to
# stay in dry-run no matter what.
TRADING_ENABLED=false

# Phone notifications (optional) -- install the free "ntfy" app, subscribe
# to a long random topic name, and put the same name here.
# `python -m kalshibot.diagnose notify` suggests one and sends a test.
NTFY_TOPIC=
